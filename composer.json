{
    "name": "vdu/audit-log",
    "description": "Bendra veiksmų žurnalizavimo (audit log) sistema Laravel projektams: prisijungimai, peržiūros, pakeitimai, sisteminiai ir saugumo įvykiai.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "audit", "logging", "security"],
    "require": {
        "php": "^7.1.3",
        "illuminate/support": "~5.7.0",
        "illuminate/database": "~5.7.0",
        "illuminate/auth": "~5.7.0",
        "monolog/monolog": "^1.23"
    },
    "require-dev": {
        "orchestra/testbench": "~3.7.0",
        "phpunit/phpunit": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Vdu\\AuditLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vdu\\AuditLog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vdu\\AuditLog\\Providers\\AuditLogServiceProvider"
            ],
            "aliases": {
                "AuditLog": "Vdu\\AuditLog\\Facades\\AuditLog"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
