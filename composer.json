{
    "name": "vdu/tis-logging",
    "description": "VDU TIS bendra veiksmų žurnalizavimo (audit log) sistema Laravel projektams: prisijungimai, peržiūros, pakeitimai, sisteminiai ir saugumo įvykiai.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "audit", "logging", "security"],
    "require": {
        "php": "^7.1.3|^8.0",
        "illuminate/support": "^5.7|^6.0|^7.0|^8.0|^9.0",
        "illuminate/database": "^5.7|^6.0|^7.0|^8.0|^9.0",
        "illuminate/auth": "^5.7|^6.0|^7.0|^8.0|^9.0",
        "monolog/monolog": "^1.23|^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "~3.7.0|^4.0|^5.0|^6.0|^7.0",
        "phpunit/phpunit": "^7.0|^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Vdu\\TisLogging\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vdu\\TisLogging\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vdu\\TisLogging\\Providers\\AuditLogServiceProvider"
            ],
            "aliases": {
                "AuditLog": "Vdu\\TisLogging\\Facades\\AuditLog"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
